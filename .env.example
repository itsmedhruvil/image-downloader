# ---------------------------------------------------------------------------
# Cloudflare R2 (optional). When these are present, generated ZIP archives are
# stored in R2 and served back via a short-lived presigned URL. When they are
# missing, the ZIP is streamed straight to the browser instead (still free).
# R2 has a generous free tier: 10 GB storage, Class A/B operations included.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=image-extractor-zips
# Optional: override the S3 endpoint (useful for MinIO or other S3-compatible stores)
R2_ENDPOINT=
# Optional: public base URL for the bucket (not required — archives are streamed via the API)
R2_PUBLIC_URL=
# How long generated ZIP archives live in R2 before expiring (seconds)
R2_ZIP_TTL_SECONDS=3600

# Optional: override the outbound User-Agent used when fetching pages/images
FETCH_USER_AGENT=

# ---------------------------------------------------------------------------
# Multi-source stock photo search (optional). Each provider is free to use but
# requires an API key; providers without a key are shown as inactive in the UI.
#   Unsplash  https://unsplash.com/developers
#   Pexels    https://www.pexels.com/api/
#   Pixabay   https://pixabay.com/api/docs/
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# Google AdSense (optional). With these set, the ad slots on the home and blog
# pages render real units; without them they render monochrome placeholders so
# the layout reserves the same space. Ads load after idle/first interaction, so
# they never block rendering.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

